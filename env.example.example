# Copy to .env locally. On Cloudflare: Workers & Pages → kalamlibrary → Settings → Variables
# (set for Production and Preview; include in build if static generation needs Supabase).
#
# Cloudflare Workers build settings (after pushing wrangler.jsonc):
#   Build command:  npx opennextjs-cloudflare build
#   Deploy command: npx opennextjs-cloudflare deploy
# Do not use plain `npx wrangler deploy` — it mis-configures WORKER_SELF_REFERENCE.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional
REVALIDATE_SECRET=long_random_string

# GA4 (loads only after user clicks "Accept analytics" on the cookie banner)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-MW536NDV91

# Search Console HTML tag: paste only the content= value (not the full meta tag)
# GSC → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
SUPABASE_SERVICE_ROLE_KEY=

# Reviews moderation (Worker secrets unless noted)
ADMIN_EMAILS=you@example.com
REVIEW_IP_HASH_SALT=long_random_string
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

SMTP_PASSWORD=
