// Cloudflare Workers & Pages → Settings → Build (required):
//   Build command:  npx opennextjs-cloudflare build
//   Deploy command: npx opennextjs-cloudflare deploy
// Avoid `npx wrangler deploy` — it re-runs migrate and can set WORKER_SELF_REFERENCE to the wrong name.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kalamlibrary",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Match the dashboard. With no routes in this file, Wrangler would otherwise
  // turn workers.dev on and could change Preview URLs on the next deploy.
  "workers_dev": true,
  "preview_urls": true,
  // Workers Caching: the edge checks this cache before running the Worker.
  // cross_version_cache is off, so each deploy starts with a cold cache (cached HTML never
  // outlives the build whose /_next/static chunks it references).
  // Requires Wrangler >= 4.107 for cross_version_cache, 4.69 for cache.enabled.
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kalamlibrary"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    }
  }
}
