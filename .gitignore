# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.open-next/

# cloudflare local secrets (use dashboard env in production)
.dev.vars

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local catalog exports
/scripts/out/

# PDF extraction workspace (local only; kalams live in Supabase)
/public/new/

# Source PDFs for local OCR/scripts — not served on the live site (Cloudflare 25 MiB/asset limit)
/public/*.pdf

# Python
__pycache__/
*.py[cod]

# typescript
*.tsbuildinfo
next-env.d.ts
